---
import Contact from "../components/Contact.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  client,
  deliverables = [],
  overview = "",
  background = "",
  imagesBase = "/assets/images",
} = Astro.props;

const workImagesBase = `${imagesBase}/work`;
const backgroundUrl = background ? `${workImagesBase}/${background}` : `${imagesBase}/nando_rossi_og.jpg`;
---

<BaseLayout
  title={title}
  section="work"
  pageClass="internal case"
  ogImage={backgroundUrl}
  description={overview || "Case study from Nando Rossi, freelance product designer."}
>
  <main class="text-obsidian bg-cream">
    <header class="case-header" style={`--image-url: url('${backgroundUrl}')`}>
      <Section class="case-header-titlebox" container="medium" marginX="wide" marginY={false}>
        <Heading level={6}>Case Study</Heading>
        <Heading level={3}>{title}</Heading>
      </Section>
    </header>

    <article class="reading relative lg:-top-32 pb-12">
      <Section
        element="section"
        class="bg-cream case-summary shadow-up-2xl"
        container="narrow"
        marginX="wide"
        marginY={false}
      >
        <div>
          <Heading level={6} class="mt-0">Client</Heading>
          <p>{client}</p>

          <Heading level={6}>Deliverables</Heading>
          <ul>
            {deliverables.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <Heading level={6} class="mt-0">Overview</Heading>
          <p>{overview}</p>
        </div>
      </Section>

      <slot />
    </article>
    <Contact imagesBase={imagesBase} />
  </main>
</BaseLayout>
