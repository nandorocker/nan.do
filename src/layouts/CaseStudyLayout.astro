---
import Contact from "../components/Contact.astro";
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  client,
  deliverables = [],
  overview = "",
  background = "",
  imagesBase = "/assets/images",
} = Astro.props;

const workImagesBase = `${imagesBase}/work`;
const backgroundUrl = background ? `${workImagesBase}/${background}` : `${imagesBase}/nando_rossi_og.jpg`;
---

<BaseLayout
  title={title}
  section="work"
  pageClass="internal case"
  ogImage={backgroundUrl}
  description={overview || "Case study from Nando Rossi, freelance product designer."}
>
  <main class="text-obsidian bg-cream">
    <header class="case-header" style={`--image-url: url('${backgroundUrl}')`}>
      <section class="margins-x-wide case-header-titlebox">
        <div class="contain-medium">
          <h6>Case Study</h6>
          <h3>{title}</h3>
        </div>
      </section>
    </header>

    <article class="reading relative lg:-top-32 pb-12">
      <section class="bg-cream case-summary contain-narrow margins-x-wide shadow-up-2xl">
        <div>
          <h6 class="mt-0">Client</h6>
          <p>{client}</p>

          <h6>Deliverables</h6>
          <ul>
            {deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h6 class="mt-0">Overview</h6>
          <p>{overview}</p>
        </div>
      </section>

      <slot />
    </article>
    <Contact imagesBase={imagesBase} />
  </main>
</BaseLayout>
