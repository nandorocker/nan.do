---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";

const imagesBase = "/assets/images";
---

<BaseLayout
  pageClass="home"
  section="home"
  ogImage={`${imagesBase}/nando_rossi_og.jpg`}
  title="nando rossi, freelance product designer"
>
  <!-- Section: Intro -->
  <section id="hero" class="hero margins-x-wide relative flex items-end" data-bg-class="bg-lavender" aria-labelledby="intro">
    <div class="lg:max-w-6xl xl:max-w-7xl text-left flex flex-col items-start max-sm:pt-40 lg:pt-20 pb-5 md:pb-0">
      <h1 class="top-line text-h4" data-aos="fade-down" data-aos-duration="600" data-aos-delay="600" data-aos-easing="ease-in-out">
        👋 Hi, I'm nando rossi <br class="sm:hidden"><wbr />— available for freelance work
      </h1>
      <h2 id="intro" class="text-h1" data-aos="fade" data-aos-duration="1200" data-aos-easing="ease-in-out">
        I make soulful software <br class="sm:hidden"><wbr />that people love to use.
      </h2>
      <div data-aos="fade" data-aos-duration="600" data-aos-delay="900" data-aos-easing="ease-in-out">
        <p class="sm:p-bigger">
          I bring two decades of design expertise creating software that empowers—not controls—the human behind the screen. I
          believe <em class="bg-lavender-200">thoughtful</em>, <em class="bg-lavender-200">ethical</em> and
          <em class="bg-lavender-200">accessible</em> design leads to better business—not to mention a better world. If you’re
          seeking a seasoned collaborator for <strong>design strategy</strong>, <strong>workshops</strong> or
          <a href="https://adplist.org/mentors/nando-rossi" target="_blank" rel="noopener noreferrer"><strong>mentoring</strong></a>,
          remote or on-site, let’s talk!
        </p>
        <a href="#contact" class="inline-block button button-large">Need a designer?</a>
      </div>
    </div>
  </section>

  <!-- Section: About -->
  <section
    id="about-me"
    class="contain-wide margins-x-wide margins-y grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-12"
    data-bg-class="bg-cherry"
    aria-labelledby="about-label"
  >
    <header class="sm:col-span-2 lg:col-span-1" data-aos="fade" data-aos-duration="1200" data-aos-delay="300" data-aos-offset="100" data-aos-easing="ease-out">
      <h2 id="about-label" class="text-h3 m-0 max-sm:text-3xl max-sm:mb-6">
        Turning ideas into beloved products through design, process, and creativity.
      </h2>
    </header>

    <picture class="window-md pic-tall sm:col-start-1 row-start-3 sm:row-start-2" data-aos="fade-right" data-aos-duration="600" data-aos-delay="300" data-aos-offset="100" data-aos-easing="ease-out">
      <img src={`${imagesBase}/nando-stairs.jpg`} alt="Profile photo of Nando Rossi" class="w-full h-auto" />
    </picture>

    <div class="sm:col-span-2 sm:col-start-2 row-start-2 md:row-start-2 lg:row-start-1" data-aos="fade" data-aos-duration="1200" data-aos-delay="300" data-aos-offset="100" data-aos-easing="ease-in-out">
      <p class="p-bigger">
        As a product designer with <strong>20 years of experience</strong>—15 of those as an independent,
        <a href="https://www.oysterhr.com/glossary/remote-first-company" target="_blank">remote-first</a> professional— I've had
        the opportunity to work with brands like <strong class="bg-cherry-300">Lego</strong>, <strong class="bg-cherry-300">Nissan</strong>,
        <strong class="bg-cherry-300">Walgreens</strong>, and <strong class="bg-cherry-300">Mattel</strong>, and play key roles in
        projects such as <strong class="bg-cherry-300">TestFlight</strong>, <strong class="bg-cherry-300">Berlin Philharmonic</strong>,
        <strong class="bg-cherry-300">Disney SpellStruck</strong> and <strong class="bg-cherry-300">Klang Games</strong>.
      </p>
      <p class="p-bigger">
        My passion for design and workflows go hand-in-hand. When <strong>workflows</strong> are thoughtfully designed to
        <strong>foster creativity</strong>, open communication, and collaboration, you get surprising outcomes—and
        <strong>products people love</strong>.
      </p>
      <p class="p-bigger">Let’s bring your vision to life and create the next success story together.</p>
    </div>
  </section>

  <!-- Section: Work -->
  <section id="work" class="contain-wide margins-x-wide margins-y" data-bg-class="bg-lime" aria-labelledby="works-label">
    <header>
      <h2 class="text-h2" id="works-label" data-aos="fade" data-aos-duration="1200" data-aos-delay="300" data-aos-easing="ease-out">
        Selected Works
      </h2>
    </header>
    <div
      class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12"
      data-aos="fade" data-aos-duration="1200" data-aos-delay="300" data-aos-offset="200" data-aos-easing="ease-in-out"
    >
      <article class="flex flex-col">
        <img src={`${imagesBase}/works-dch-thumb.png`} alt="Berlin Philharmonic app preview" class="w-full h-52 sm:h-40 object-cover rounded-lg shadow-obsidian shadow-2xl-flat-r" />
        <header class="mt-8">
          <span class="text-sm uppercase font-bold">App Design</span>
          <h3 class="text-h5 mt-2">Redefining the digital viewing landscape of the Berlin Philharmonic.</h3>
        </header>
        <p class="mt-4 flex-grow">
          A pioneer in its category, the Berlin Philharmonic's subscription service is available on most platforms. In a highly
          fragmented environment, I helped solve the difficult problems of user experience consistency, maintainability and team
          inclusion leading to increased user satisfaction and subscriptions.
        </p>
        <a href="/work/digital-concert-hall" class="text-2xl underline decoration-2 hover:decoration-lavender transition-colors duration-300 mt-4 inline-block">Read The Story</a>
      </article>

      <article class="flex flex-col">
        <img src={`${imagesBase}/works-testflight-thumb.png`} alt="TestFlight branding" class="w-full h-52 sm:h-40 object-cover rounded-lg shadow-obsidian shadow-2xl-flat-r" />
        <header class="mt-8">
          <span class="text-sm uppercase font-bold">App Testing Platform</span>
          <h3 class="text-h5 mt-2">TestFlight: Solving Real Problems, with a whole lot of Character.</h3>
        </header>
        <p class="mt-4 flex-grow">
          It all started with a small team aiming to simplify mobile testing and build something developers
          would love. From POC to industry favorite, I led the design that balanced robust functionality with a
          playful, approachable brand, which grew TestFlight into the essential tool it is today.
        </p>
        <a href="/work/testflight" class="text-2xl underline decoration-2 hover:decoration-lavender transition-colors duration-300 mt-4 inline-block">Read The Story</a>
      </article>

      <article class="flex flex-col">
        <img src={`${imagesBase}/works-spellstruck-keyart.png`} alt="Disney SpellStruck key art" class="w-full h-52 sm:h-40 object-cover rounded-lg shadow-obsidian shadow-2xl-flat-r" />
        <header class="mt-8">
          <span class="text-sm uppercase font-bold">Game Dev</span>
          <h3 class="text-h5 mt-2">Disney SpellStruck, a twist on a classic—with your favorite characters.</h3>
        </header>
        <p class="mt-4 flex-grow">
          Working with indie Artist Arcade and the lead developer of <strong>Words With Friends</strong>, I helped create and launch this
          exciting word puzzle for Disney. I brought focus on usability and modularity, setting things up for continuous expansion
          through the years.
        </p>
        <a href="/work/disney-spellstruck" class="text-2xl underline decoration-2 hover:decoration-lavender transition-colors duration-300 mt-4 inline-block disable">Read The Story</a>
      </article>
    </div>
  </section>

  <!-- Section: Services -->
  <section id="services" class="contain-wide margins-x-wide margins-y services" data-bg-class="bg-amber-200" aria-labelledby="services-label">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-5 md:gap-x-16">
      <h2 class="text-h1" id="services-label" data-aos="fade" data-aos-duration="1200" data-aos-offset="200" data-aos-easing="ease-in-out">Services</h2>

      <div class="lg:col-span-2 grid grid-cols-1 lg:grid-cols-2 gap-y-2 lg:gap-y-8 gap-x-8" data-aos="fade" data-aos-duration="1200" data-aos-offset="200" data-aos-easing="ease-in-out">
        <article>
          <header>
            <h3 class="text-h5">Product Design &amp; UX Strategy</h3>
          </header>
          <p class="p-smaller">
            Building products that people love and keep coming back to. Trusted by Fortune 500s and startups alike.
          </p>
          <ul class="p-smaller mt-2">
            <li>Product design (apps, web, SaaS)</li>
            <li>User research &amp; usability testing</li>
            <li>Information architecture</li>
            <li>UX audits &amp; conversion optimization</li>
          </ul>
        </article>

        <article>
          <header>
            <h3 class="text-h5">Design Systems &amp; Operations</h3>
          </header>
          <p class="p-smaller">
            Ship faster with systems that keep design and engineering in sync. Built for startups to enterprise platforms.
          </p>
          <ul class="p-smaller mt-2">
            <li>Design system architecture</li>
            <li>Component library design</li>
            <li>Design-to-development workflow</li>
            <li>Design ops consulting</li>
          </ul>
        </article>

        <article>
          <header>
            <h3 class="text-h5">AI-Powered Prototyping</h3>
          </header>
          <p class="p-smaller">
            Go from idea to working prototype in days. Close deals and validate concepts before full development.
          </p>
          <ul class="p-smaller mt-2">
            <li>Interactive prototypes (Next.js, React)</li>
            <li>Rapid MVP development</li>
            <li>Clickable demos &amp; pitch decks</li>
            <li>Front-end development</li>
          </ul>
        </article>

        <article>
          <header>
            <h3 class="text-h5">Website Design &amp; Development</h3>
          </header>
          <p class="p-smaller">
            Websites that look great and perform better. From first impression to conversion.
          </p>
          <ul class="p-smaller mt-2">
            <li>Custom website design &amp; development</li>
            <li>Framer website design</li>
            <li>Responsive web design</li>
            <li>SEO optimization &amp; CMS integration</li>
          </ul>
        </article>

        <article>
          <header>
            <h3 class="text-h5">Cross-Platform Experience Design</h3>
          </header>
          <p class="p-smaller">
            One experience, every screen. Mobile to TV with accessibility that reaches everyone.
          </p>
          <ul class="p-smaller mt-2">
            <li>Mobile app design (iOS, Android)</li>
            <li>Responsive web design</li>
            <li>Smart TV &amp; streaming interfaces</li>
            <li>Accessible design (WCAG)</li>
          </ul>
        </article>

        <article>
          <header>
            <h3 class="text-h5">Design Team Leadership &amp; Mentoring</h3>
          </header>
          <p class="p-smaller">
            Turn good designers into great teams. Build processes that scale and capabilities that compound.
          </p>
          <ul class="p-smaller mt-2">
            <li>Design team management</li>
            <li>UX process optimization</li>
            <li>Design mentorship &amp; coaching</li>
            <li>AI workflow implementation</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Section: Brands -->
  <section id="brands" class="contain-wide margins-x-wide margins-y" data-bg-class="bg-lavender" aria-labelledby="brands-label">
    <h3 class="mb-6 md:mb-10 lg:text-4xl text-center" id="brands-label" data-aos="fade" data-aos-duration="1200" data-aos-offset="200" data-aos-easing="ease-in-out">
      Leading Brands <wbr />I've Worked With
    </h3>
    <article class="window-md bg-cream brands" data-aos="fade" data-aos-duration="400" data-aos-offset="200" data-aos-easing="ease-out">
      <img src={`${imagesBase}/logo-artist-arcade.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-offset="200" data-aos-easing="ease-out" alt="Artist Arcade" />
      <img src={`${imagesBase}/logo-disney.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="100" data-aos-offset="200" data-aos-easing="ease-out" alt="Disney" />
      <img src={`${imagesBase}/logo-bph.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="150" data-aos-offset="200" data-aos-easing="ease-out" alt="Berliner Philharmonic" />
      <img src={`${imagesBase}/logo-nissan.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="200" data-aos-offset="200" data-aos-easing="ease-out" alt="Nissan" />
      <img src={`${imagesBase}/logo-discovery.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="250" data-aos-offset="200" data-aos-easing="ease-out" alt="Discovery Channel" />
      <img src={`${imagesBase}/logo-evenly.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="300" data-aos-offset="200" data-aos-easing="ease-out" alt="Evenly" />
      <img src={`${imagesBase}/logo-walgreens.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="350" data-aos-offset="200" data-aos-easing="ease-out" alt="Walgreens" />
      <img src={`${imagesBase}/logo-beam-suntory.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="400" data-aos-offset="200" data-aos-easing="ease-out" alt="Beam Suntory" />
      <img src={`${imagesBase}/logo-lego.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="450" data-aos-offset="200" data-aos-easing="ease-out" alt="Lego" />
      <img src={`${imagesBase}/logo-mattel.png`} class="brands-logo" data-aos="fade" data-aos-duration="400" data-aos-delay="500" data-aos-offset="200" data-aos-easing="ease-out" alt="Mattel" />
    </article>
  </section>

  <Contact imagesBase={imagesBase} />
</BaseLayout>
