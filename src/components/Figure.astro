---
import { Image } from "astro:assets";

export interface Props {
  src: string;
  alt: string;
  caption?: string;
  class?: string;
  imageClass?: string;
  captionClass?: string;
  width?: number;
  height?: number;
  layout?: "default" | "window-sm" | "window-md" | "window-rounded";
  lightbox?: boolean;
  aos?: boolean;
  aosEffect?: string;
  aosDuration?: number;
  aosDelay?: number;
  aosOffset?: number;
  aosEasing?: string;
  isVideo?: boolean;
  videoProps?: {
    controls?: boolean;
    autoplay?: boolean;
    loop?: boolean;
  };
}

const {
  src,
  alt,
  caption,
  class: className = "",
  imageClass = "",
  captionClass = "",
  width = 1200,
  height = 800,
  layout = "default",
  lightbox = false,
  aos = false,
  aosEffect = "fade-up",
  aosDuration = 600,
  aosDelay = 0,
  aosOffset = 100,
  aosEasing = "ease-out",
  isVideo = false,
  videoProps = {},
} = Astro.props;

const layoutClasses = {
  default: "",
  "window-sm": "window-sm",
  "window-md": "window-md",
  "window-rounded": "window-rounded",
};

const figureClasses = [className].filter(Boolean).join(" ");

const imageClasses = [layoutClasses[layout], imageClass].filter(Boolean).join(" ");

const aosAttrs = aos
  ? {
      "data-aos": aosEffect,
      "data-aos-duration": aosDuration.toString(),
      "data-aos-delay": aosDelay.toString(),
      "data-aos-offset": aosOffset.toString(),
      "data-aos-easing": aosEasing,
    }
  : {};
---

<figure class={figureClasses}>
  {
    lightbox && !isVideo ? (
      <a data-fslightbox href={src}>
        {isVideo ? (
          <video
            width={width}
            height={height}
            controls={videoProps.controls}
            autoplay={videoProps.autoplay}
            loop={videoProps.loop}
            class={imageClasses}
            {...aosAttrs}
          >
            <source src={src} type="video/mp4" />
          </video>
        ) : (
          <Image
            src={src}
            alt={alt}
            class={imageClasses}
            width={width}
            height={height}
            {...aosAttrs}
          />
        )}
      </a>
    ) : isVideo ? (
      <video
        width={width}
        height={height}
        controls={videoProps.controls}
        autoplay={videoProps.autoplay}
        loop={videoProps.loop}
        class={imageClasses}
        {...aosAttrs}
      >
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <Image
        src={src}
        alt={alt}
        class={imageClasses}
        width={width}
        height={height}
        {...aosAttrs}
      />
    )
  }
  {caption && <figcaption class={captionClass}><span>{caption}</span></figcaption>}
</figure>
